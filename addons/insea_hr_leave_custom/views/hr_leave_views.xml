<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_leave_form_insea" model="ir.ui.view">
        <field name="name">hr.leave.form.insea</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="insea_policy" invisible="1"/>
                <field name="insea_exit_reason" invisible="insea_policy != 'short_exit'" readonly="state != 'draft'"/>
                <field name="insea_needs_attachment" string="Justificatif obligatoire à la validation"
                       invisible="not insea_needs_attachment" readonly="1"/>
            </xpath>
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,confirm,validate1,validate</attribute>
            </xpath>
        </field>
    </record>
</odoo>
